{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "revision",
    "scope",
    "findings",
    "coverage",
    "limitations"
  ],
  "properties": {
    "revision": {
      "type": "string",
      "description": "Geprüfte Revision"
    },
    "scope": {
      "type": "string",
      "description": "Prüfumfang"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "severity",
          "severity_rationale",
          "confidence",
          "status",
          "revision",
          "locations",
          "expected",
          "actual",
          "root_cause",
          "impact",
          "evidence",
          "counter_evidence",
          "verification",
          "remediation",
          "regression_test",
          "uncertainty"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "informational"
            ]
          },
          "severity_rationale": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "status": {
            "enum": [
              "confirmed",
              "probable",
              "unverified",
              "refuted"
            ]
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "start_line",
                "end_line"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "root_cause": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "counter_evidence": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          },
          "regression_test": {
            "type": "string",
            "minLength": 1
          },
          "uncertainty": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "description": "Befunde und Verdachtsfälle"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component",
          "module",
          "status",
          "reason"
        ],
        "properties": {
          "component": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "status": {
            "enum": [
              "reviewed",
              "partial",
              "not-reviewed",
              "not-applicable"
            ]
          },
          "reason": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Prüfregister"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Einschränkungen"
    }
  },
  "additionalProperties": false,
  "title": "Bericht zur Codebasis-Prüfung",
  "description": "Maschinenlesbarer Prüfbericht. Technische Schlüssel und Aufzählungswerte bleiben unverändert; Freitext auf Deutsch."
}
